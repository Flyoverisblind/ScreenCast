<Window x:Class="ScreenCast.CastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机画面"
        Width="560" Height="960"
        MinWidth="280" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontFamily="Segoe UI, sans-serif">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear" />

        <Border x:Name="Placeholder" Background="#FF1D1B20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="等待画面…" Foreground="White" FontSize="20" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
