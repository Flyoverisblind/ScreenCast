<Window x:Class="ScreenCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ScreenCast.Converters"
        Title="ScreenCast — 安卓投屏"
        Height="760" Width="1240"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.WindowBackground}"
        FontFamily="{StaticResource Font.Body}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" Padding="20,14" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Brush.Primary}" Margin="0,0,12,0">
                        <TextBlock Text="SC" Foreground="{StaticResource Brush.OnPrimary}" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ScreenCast" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="低延迟安卓投屏 · USB / 无线" Style="{StaticResource Text.Label}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新设备" Style="{StaticResource MD3.TextButton}" Click="OnRefreshDevices" />
                    <Button Content="USB 连接" Style="{StaticResource MD3.OutlinedButton}" Margin="8,0,0,0" Click="OnUsbConnect" />
                    <ComboBox x:Name="DisplayModeCombo" Width="100" SelectedIndex="1" Margin="8,0,0,0"
                              Style="{StaticResource MD3.ComboBox}" SelectionChanged="DisplayModeCombo_SelectionChanged">
                        <ComboBoxItem Content="铺满" Tag="Fill" />
                        <ComboBoxItem Content="等比" Tag="UniformToFill" />
                        <ComboBoxItem Content="完整显示" Tag="Uniform" />
                    </ComboBox>
                    <Button Content="开始投屏" Style="{StaticResource MD3.FilledButton}" Margin="8,0,0,0" Click="OnStartCast" />
                    <Button Content="停止" Style="{StaticResource MD3.OutlinedButton}" Margin="8,0,0,0" Click="OnStopCast" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：设备与无线连接 -->
            <Border Grid.Column="0" Style="{StaticResource MD3.Card}">
                <StackPanel>
                    <TextBlock Text="设备" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />

                    <ListBox x:Name="DeviceList"
                             ItemContainerStyle="{StaticResource MD3.ListBoxItem}"
                             Height="220" BorderThickness="0" Background="Transparent"
                             SelectionChanged="DeviceList_SelectionChanged" />

                    <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,12" />

                    <TextBlock Text="无线连接" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                    <TextBlock Text="手机开启无线调试后填写 IP 与端口" Style="{StaticResource Text.Label}" Margin="0,0,0,12" />

                    <TextBlock Text="IP 地址" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="WirelessIp" Style="{StaticResource MD3.TextBox}" Margin="0,4,0,10" Text="192.168.1." />

                    <TextBlock Text="端口" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="WirelessPort" Style="{StaticResource MD3.TextBox}" Margin="0,4,0,12" Text="5555" />

                    <Button Content="无线连接" Style="{StaticResource MD3.FilledButton}" Click="OnWirelessConnect" />
                </StackPanel>
            </Border>

            <!-- 中间：提示（画面已移至独立投屏窗口） -->
            <Border Grid.Column="2" Style="{StaticResource MD3.Card}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📱" FontSize="56" HorizontalAlignment="Center" />
                    <TextBlock Text="手机画面将在独立窗口显示" Style="{StaticResource Text.Title}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="选择设备后点击「开始投屏」，会自动打开独立画面窗口；在窗口内可用鼠标/键盘控制手机" Style="{StaticResource Text.BodyMedium}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>
            </Border>

            <!-- 右侧：设置 -->
            <Border Grid.Column="4" Style="{StaticResource MD3.Card}">
                <StackPanel>
                    <TextBlock Text="投屏设置" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />

                    <TextBlock Text="分辨率" Style="{StaticResource Text.Label}" />
                    <ComboBox x:Name="ResolutionCombo" Style="{StaticResource MD3.ComboBox}" Margin="0,4,0,12">
                        <ComboBoxItem Content="1920 × 1080" Tag="1920x1080" IsSelected="True" />
                        <ComboBoxItem Content="1280 × 720" Tag="1280x720" />
                        <ComboBoxItem Content="854 × 480" Tag="854x480" />
                    </ComboBox>

                    <TextBlock Text="码率 (Mbps)" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="BitRateBox" Style="{StaticResource MD3.TextBox}" Margin="0,4,0,12" Text="8" />

                    <TextBlock Text="帧率 (FPS)" Style="{StaticResource Text.Label}" />
                    <ComboBox x:Name="FpsCombo" Style="{StaticResource MD3.ComboBox}" Margin="0,4,0,12">
                        <ComboBoxItem Content="120" />
                        <ComboBoxItem Content="90" />
                        <ComboBoxItem Content="60" IsSelected="True" />
                        <ComboBoxItem Content="30" />
                        <ComboBoxItem Content="15" />
                    </ComboBox>

                    <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,8,0,12" />

                    <CheckBox x:Name="EnableAudioCheck" Content="播放手机声音" IsChecked="True"
                              Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,8" />
                    <CheckBox x:Name="EnableControlCheck" Content="电脑反向控制手机" IsChecked="True"
                              Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,12" />

                    <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,8,0,12" />

                    <TextBlock Text="连接方式" Style="{StaticResource Text.Label}" />
                    <TextBlock x:Name="ConnectionInfo" Style="{StaticResource Text.BodyMedium}" Margin="0,4,0,0"
                               Text="未连接" TextWrapping="Wrap" />

                    <TextBlock Text="状态" Style="{StaticResource Text.Label}" Margin="0,12,0,0" />
                    <TextBlock x:Name="StateText" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                               Text="就绪" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" Padding="16,6" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AdbStatus" Style="{StaticResource Text.Label}" Text="adb: 检测中…" />
                <TextBlock Grid.Column="2" x:Name="StatsText" Style="{StaticResource Text.Label}" Text="0 fps" />
            </Grid>
        </Border>
    </Grid>
</Window>
